# TIP Media Intelligence - Environment Variables Configuration

# Application
SECRET_KEY=tip-media-intelligence-secret-key-2026
DATABASE_URL=sqlite:///./tip_media.db

# Multi-Model AI Engine
# Provider options: openai_compatible | gemini | claude | ollama | groq
AI_PROVIDER=openai_compatible

# Examples:
# For Google Gemini (via OpenAI-compatible endpoint):
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# AI_MODEL_NAME=gemini-1.5-flash
# AI_API_KEY=AIzaSy...

# For OpenAI:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL_NAME=gpt-4o-mini
# AI_API_KEY=sk-...

# For Ollama (Local):
# AI_BASE_URL=http://localhost:11434/v1
# AI_MODEL_NAME=llama3.2
# AI_API_KEY=ollama

# For Groq:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL_NAME=llama-3.1-70b-versatile
# AI_API_KEY=gsk_...

AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=1500

# JEV / Fast Binary Yes/No Triage Gatekeeper
# Evaluates binary propositions (is_incident, is_noise, requires_analyst)
JEV_ENABLED=true
JEV_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai/v1
JEV_INCIDENT_THRESHOLD=0.60
JEV_NOISE_THRESHOLD=0.75
