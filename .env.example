# Database (PostgreSQL 16 + pgvector + PostGIS)
DATABASE_URL=postgresql+psycopg2://tip_user:tip_password@localhost:5432/tip_media
# Fallback dev lokal:
# DATABASE_URL=sqlite:///./tip_media.db

# Keamanan & Auth
SECRET_KEY=ganti-dengan-secret-key-panjang-acak-minimal-32-karakter
AUTH_REQUIRED=false
JWT_EXPIRE_MINUTES=480

# Keycloak OIDC (opsional, untuk SSO & MFA instansi)
KEYCLOAK_ENABLED=false
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=tip-media
KEYCLOAK_CLIENT_ID=tip-backend
KEYCLOAK_CLIENT_SECRET=

# Redis & Celery Worker
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
AUTO_COLLECT_MINUTES=10

# MinIO / S3 Object Storage (PDF laporan, bukti kasus, backup)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=tip-media-artifacts
S3_BACKUP_BUCKET=tip-media-backups

# Notifikasi Eksekutif (FR-16 & FR-17)
TELEGRAM_BOT_TOKEN=
TELEGRAM_DEFAULT_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@tip-media.local
EMAIL_DEFAULT_TO=
WA_BSP_URL=
WA_BSP_TOKEN=
WA_DEFAULT_TO=
QUIET_HOURS_START=22
QUIET_HOURS_END=6

# AI Engine & JEV / IndoBERT
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash
INDOBERT_ENDPOINT=
EMBEDDING_ENDPOINT=

# OpenSearch (FR-21)
OPENSEARCH_ENABLED=false
OPENSEARCH_URL=http://localhost:9200

# Real-time Social Pulse Legal (FR-25)
X_BEARER_TOKEN=
X_STREAM_RULES=place_country:ID
SOCIAL_WEBHOOK_SECRET=

# Retensi & Observability (NFR-06, NFR-10)
RETENTION_DAYS=365
SENTRY_DSN=
